{
  "name": "@lucent/react",
  "version": "0.0.1",
  "description": "Minimal glassmorphic React component library",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "react",
    "glassmorphism",
    "ui",
    "components",
    "design-system"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "radix-ui": "^1.6.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./glass-surface": {
      "types": "./dist/primitives/GlassSurface/index.d.ts",
      "import": "./dist/primitives/GlassSurface/index.js"
    },
    "./button": {
      "types": "./dist/primitives/Button/index.d.ts",
      "import": "./dist/primitives/Button/index.js"
    },
    "./icon-button": {
      "types": "./dist/primitives/IconButton/index.d.ts",
      "import": "./dist/primitives/IconButton/index.js"
    },
    "./text": {
      "types": "./dist/primitives/Text/index.d.ts",
      "import": "./dist/primitives/Text/index.js"
    },
    "./heading": {
      "types": "./dist/primitives/Heading/index.d.ts",
      "import": "./dist/primitives/Heading/index.js"
    },
    "./link": {
      "types": "./dist/primitives/Link/index.d.ts",
      "import": "./dist/primitives/Link/index.js"
    },
    "./separator": {
      "types": "./dist/primitives/Separator/index.d.ts",
      "import": "./dist/primitives/Separator/index.js"
    },
    "./avatar": {
      "types": "./dist/primitives/Avatar/index.d.ts",
      "import": "./dist/primitives/Avatar/index.js"
    },
    "./aspect-ratio": {
      "types": "./dist/primitives/AspectRatio/index.d.ts",
      "import": "./dist/primitives/AspectRatio/index.js"
    },
    "./badge": {
      "types": "./dist/primitives/Badge/index.d.ts",
      "import": "./dist/primitives/Badge/index.js"
    },
    "./kbd": {
      "types": "./dist/primitives/Kbd/index.d.ts",
      "import": "./dist/primitives/Kbd/index.js"
    },
    "./slot": {
      "types": "./dist/utils/Slot/index.d.ts",
      "import": "./dist/utils/Slot/index.js"
    },
    "./visually-hidden": {
      "types": "./dist/utils/VisuallyHidden/index.d.ts",
      "import": "./dist/utils/VisuallyHidden/index.js"
    },
    "./accessible-icon": {
      "types": "./dist/utils/AccessibleIcon/index.d.ts",
      "import": "./dist/utils/AccessibleIcon/index.js"
    },
    "./portal": {
      "types": "./dist/utils/Portal/index.d.ts",
      "import": "./dist/utils/Portal/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./glass.css": "./dist/styles/glass.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./theme.css": "./dist/theme/ThemePanel.css",
    "./tailwind": "./dist/tailwind/preset.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:tokens": "node --import tsx/esm style-dictionary.config.ts",
    "build": "pnpm run build:tokens && tsup",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "qa:publint": "publint",
    "qa:attw": "attw --pack --profile esm-only --exclude-entrypoints \"./styles.css\" \"./glass.css\" \"./fonts.css\" \"./theme.css\" \"./tailwind\"",
    "qa:size": "size-limit",
    "ci": "pnpm run build && pnpm run lint:css && pnpm run test && pnpm run qa:publint && pnpm run qa:attw && pnpm run qa:size"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^13.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.12.0",
    "happy-dom": "^20.11.1",
    "publint": "^0.3.22",
    "size-limit": "^13.0.1",
    "style-dictionary": "^5.5.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^37.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
