{
  "name": "lucent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lucent/demo dev",
    "build": "pnpm --filter @orionshub/lucent build && pnpm --filter glassui build",
    "build:glassui": "pnpm --filter glassui build",
    "test": "pnpm --filter @orionshub/lucent test",
    "ci": "pnpm --filter @orionshub/lucent ci && pnpm --filter glassui build",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
